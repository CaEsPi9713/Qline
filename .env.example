# ==============================================================================
# QLine - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure values appropriate for your environment:
#   cp .env.example .env
#
# Do NOT commit real credentials or .env to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# MongoDB Configuration
# ------------------------------------------------------------------------------
# Required when MongoDB authentication is enabled (e.g. university server).
# Used to construct URI: mongodb://user:pass@host:port/db?authSource=db
MONGO_USER=your_mongo_username_here
MONGO_PASS=your_mongo_password_here
MONGO_DB=grupo2_db

# MongoDB server host and port.
# Optional: Defaults to 127.0.0.1 and 27017 in app/main.py if omitted.
MONGO_HOST=127.0.0.1
MONGO_PORT=27017

# ------------------------------------------------------------------------------
# Redis Configuration
# ------------------------------------------------------------------------------
# Redis server host and port.
# Optional: Defaults to 127.0.0.1 and 6379 in app/redis_client.py if omitted.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Redis authentication password.
# Optional: Leave blank if Redis does not require a password.
REDIS_PASS=

# ------------------------------------------------------------------------------
# Application & Routing Configuration
# ------------------------------------------------------------------------------
# Public URL subpath prefix when running behind a reverse proxy (e.g. Apache).
# Example for university deployment: /proyecto/qline
# Leave blank when running directly at the root path (http://127.0.0.1:8000/).
BASE_PATH=

# Public domain/base URL used to construct client QR consulta links (HU-003 / HU-013).
# Must be accessible from mobile devices and must NEVER be localhost in production.
# Example for course deployment: https://grupo2.crnube.net
PUBLIC_BASE_URL=https://grupo2.crnube.net

# ------------------------------------------------------------------------------
# Abandono automatico de turnos (HU-008)
# ------------------------------------------------------------------------------
# Marca como abandonados los turnos llamados que no se presentan en 180 s. 0 lo apaga.
BARRIDO_ABANDONO=1
# Segundos entre pasadas del barrido.
BARRIDO_INTERVALO_SEG=10

# ------------------------------------------------------------------------------
# Zona horaria de las pantallas
# ------------------------------------------------------------------------------
# Las fechas se guardan y se entregan en UTC; las pantallas las muestran en esta zona (nombre IANA).
# Si falta o no existe, se muestra en UTC. Valor por defecto: America/Costa_Rica
ZONA_HORARIA=America/Costa_Rica
