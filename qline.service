[Unit]
Description=QLine / MongoDB Web Admin (FastAPI)
After=network.target mongod.service redis-server.service

[Service]
User=grupo2
Group=grupo2
WorkingDirectory=/home/grupo2/qline
ExecStart=/home/grupo2/qline/venv/bin/gunicorn app.main:app -k uvicorn.workers.UvicornWorker -w 2 -b 127.0.0.1:8001
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
